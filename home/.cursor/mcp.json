{
  "mcpServers": {
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"]
    }
  },
  "templates": {
    "template-mcp-files": {
      "command": "npx",
      "args": ["-y", "mcp-files"],
      "env": {
        "DEBUG": "true",
        "COLLECT_MISMATCHES": "true"
      }
    },
    "template-postgres": {
      "command": "uv",
      "args": [
        "run",
        "postgres-mcp",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "postgres://username:password@localhost:5432/database?options=-csearch_path%3Dschema_name"
      }
    },
    "template-graphql-local": {
      "command": "npx",
      "args": ["mcp-graphql"],
      "env": {
        "ENDPOINT": "http://127.0.0.1:4001/_/gql",
        "ALLOW_MUTATIONS": "true",
        "HEADERS": "{\"Authorization\":\"Email user@example.com\",\"User-Agent\": \"Cursor\"}"
      }
    },
    "template-slack": {
      "command": "npx",
      "args": [
        "-y",
        "slack-mcp-server@latest",
        "--transport",
        "stdio"
      ],
      "env": {
        "SLACK_MCP_ADD_MESSAGE_TOOL": "true",
        "SLACK_MCP_XOXC_TOKEN": "$XOXC_TOKEN",
        "SLACK_MCP_XOXD_TOKEN": "$XOXD_TOKEN"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "note": "Replaced with a /context7 SKILL"
    }
  }
}