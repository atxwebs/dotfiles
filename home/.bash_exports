# Add `~/bin` to the `$PATH`
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# Avoid duplicate entries
export HISTCONTROL="erasedups:ignoreboth"

# Don't record some commands
# Note: Adding patterns to prevent shell option commands from cluttering history
# HISTIGNORE uses glob patterns - "set +o*" matches "set +o ignoreeof", "set +o pipefail", etc.
export HISTIGNORE="&:[ ]*:exit:ls:bg:fg:set:set +o*:set -o*:cd:p:e:clear:cm:st:pop:z:t:hg:which:eval:npmi:npm i:npmrm:npm rm:chmod:mkdir"

# Keep more entries in the bash history
export HISTSIZE=3000

# Set Sublime as Editor
export EDITOR='code -w'

# Flush to history on every command
if [[ "$PROMPT_COMMAND" != *"history -a"* ]]; then
	# Remove trailing whitespace and semicolons
	PROMPT_COMMAND="${PROMPT_COMMAND%"${PROMPT_COMMAND##*[![:space:];]}"}"
	# Add separator if PROMPT_COMMAND exists and doesn't end with semicolon
	if [[ -n "$PROMPT_COMMAND" && "$PROMPT_COMMAND" != *";" ]]; then
		PROMPT_COMMAND="$PROMPT_COMMAND ;"
	fi
	export PROMPT_COMMAND="$PROMPT_COMMAND history -a; "
fi

# Use less command as a pager
export PAGER=less


# Default command for fzf (filter alias)
export FZF_DEFAULT_COMMAND='find . ! -path "*.git*" ! -path "*node_modules*"'

# Bat tool configuration
export BAT_PAGER=
export BAT_THEME="Monokai Extended Bright"
export BAT_TABS=2

# Difftastic settings
export DFT_CONTEXT=1
export DFT_TAB_WIDTH=2

# For dictation
export LIBALSA_LOG_LEVEL=0
export LIBGL_ALWAYS_SOFTWARE=1

# Force correct TERM for SSH compatibility (Kitty reports xterm-kitty by default)
export TERM=xterm-256color

export PRISMA_HIDE_UPDATE_MESSAGE=1
export LIGHTPANDA_DISABLE_TELEMETRY=true

# Skip git reading /etc/gitconfig, Cursor can't
export GIT_CONFIG_NOSYSTEM=1

# === CloakBrowser + agent-browser for Hermes. Just `agent-browser` uses the correct flags and binary ===
for f in ~/.cloakbrowser/chromium-*/chrome; do export AGENT_BROWSER_EXECUTABLE_PATH="$f"; done
export AGENT_BROWSER_ARGS=--disable-blink-features=AutomationControlled,--no-first-run,--no-default-browser-check,--disable-infobars,--blink-settings=imagesEnabled=false
export AGENT_BROWSER_IDLE_TIMEOUT_MS=180000   # 3 minutes exactly like your current setup
export BROWSER_INACTIVITY_TIMEOUT=180         # optional — syncs Hermes cleanup