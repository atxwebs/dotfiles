# defaults.pcm.card 2
# defaults.pcm.device 0
# defaults.ctl.card 2
# pcm.!default {
#     type plug
#     slave {
#         pcm "hw:2,0"
#     }
# }
# ctl.!default {
#     type hw
#     card 2
# }
# # Suppress OSS, HDMI, phoneline, and modem
# pcm.oss {
#     type plug
#     slave.pcm null
# }

pcm.!default {
    type plug
    slave {
        pcm "hw:2,0"
    }
}
ctl.!default {
    type hw
    card 2
}