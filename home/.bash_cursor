#!/bin/bash
# Auto-setup for AI agent shell environment
if [[ "$PS1" != *🤖* ]]; then
  # Load existing history but disable saving new history
  history -r 2>/dev/null || true
  set +o history
  
  # SECURITY: Set 30-second sudo timeout for AI shell
  alias sudo='sudo -T 30'
  
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  PS1="🤖\n\$ "
  export GIT_PAGER=""
  export PAGER="cat"
  # Use native git diff (bypass diff.external/difft)
  git() {
    if [[ "$1" == "diff" ]]; then
      command git diff --no-ext-diff "${@:2}"
    else
      command git "$@"
    fi
  }
  export EDITOR="nano"
  # Simplify formatting for cursor
  export RIPGREP_CONFIG_PATH=~/.ripgreprc
  export PROMPT_COMMAND=""

  # Auto-switch AWS profile based on directory
  if type -t aws_infer_profile >/dev/null 2>&1; then
    aws_infer_profile
  fi

  echo "🤖 Shell setup complete"
else
  echo "🤖 Shell already configured"
fi
